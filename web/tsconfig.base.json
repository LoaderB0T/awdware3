{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2020",
    "module": "esnext",
    "lib": [
      "es2017",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@awdlab/analytics": [
        "libs/analytics/src/index.ts"
      ],
      "@awdlab/bootstrap": [
        "libs/bootstrap/src/index.ts"
      ],
      "@awdlab/externals": [
        "libs/externals/src/index.ts"
      ],
      "@awdlab/home": [
        "libs/modules/home/src/index.ts"
      ],
      "@awdlab/projects": [
        "libs/modules/projects/src/index.ts"
      ],
      "@awdlab/shared": [
        "libs/shared/src/index.ts"
      ],
      "@awdlab/styles": [
        "libs/styles/src/index.ts"
      ],
      "@awdlab/timeline": [
        "libs/modules/timeline/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
